<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>언주중학교 급식 알리미</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts (Noto Sans KR) -->
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800;900&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Noto Sans KR', sans-serif;
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen text-black pb-16">

  <!-- Header Header (Black & White & PE Blue) -->
  <header class="bg-black text-white sticky top-0 z-30 shadow-md border-b-4 border-blue-600">
    <div class="max-w-3xl mx-auto px-5 py-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white font-black text-xl shadow-lg">
          <i class="fa-solid fa-utensils"></i>
        </div>
        <div>
          <h1 class="font-extrabold text-lg text-white leading-tight tracking-tight">언주중 급식 알리미</h1>
          <p class="text-xs text-blue-400 font-bold">3학년 체육복 BLUE EDITION</p>
        </div>
      </div>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-black bg-blue-600 text-white shadow-sm">
        <i class="fa-solid fa-graduation-cap mr-1.5"></i> 언주중학교
      </span>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-3xl mx-auto px-4 pt-6 space-y-6">

    <!-- Hero / Banner (Black Background + PE Blue Accent) -->
    <div class="bg-black rounded-3xl p-6 text-white shadow-xl relative overflow-hidden border-2 border-slate-900">
      <div class="relative z-10">
        <span class="bg-blue-600 text-white text-xs font-black px-3 py-1 rounded-md uppercase tracking-wider">NEIS 실시간 연동</span>
        <h2 class="text-2xl font-black mt-3 mb-1.5 text-white">오늘 점심, 먹어도 될까?</h2>
        <p class="text-slate-300 text-sm max-w-xl font-medium">날짜 선택 ➔ 알레르기 클릭 ➔ 안전한 메뉴 바로 확인!</p>
      </div>
      <!-- PE Uniform Stripe Decorative element -->
      <div class="absolute right-0 top-0 bottom-0 w-24 bg-blue-600/20 transform skew-x-12 translate-x-6"></div>
      <div class="absolute right-12 top-0 bottom-0 w-12 bg-blue-600/30 transform skew-x-12"></div>
      <i class="fa-solid fa-shield-halved absolute -right-2 -bottom-4 text-blue-600/20 text-8xl pointer-events-none"></i>
    </div>

    <!-- STEP 1 & 2 Section Card (Clean White Container with High Contrast) -->
    <div class="bg-white rounded-3xl shadow-md border-2 border-black p-6 space-y-6">
      
      <!-- STEP 1: Date Input -->
      <div>
        <label for="meal-date" class="flex items-center text-sm font-black text-black mb-2.5">
          <span class="w-7 h-7 rounded-lg bg-black text-white text-xs font-black flex items-center justify-center mr-2 shadow">1</span>
          STEP 1. 급식 날짜 선택
        </label>
        <div class="relative max-w-xs">
          <input type="date" id="meal-date" class="w-full bg-slate-50 border-2 border-black text-black text-sm rounded-xl focus:ring-4 focus:ring-blue-600 focus:border-blue-600 block p-3 font-bold shadow-sm transition">
        </div>
      </div>

      <hr class="border-slate-200">

      <!-- STEP 2: Allergy Selection -->
      <div>
        <div class="flex items-center justify-between mb-3">
          <label class="flex items-center text-sm font-black text-black">
            <span class="w-7 h-7 rounded-lg bg-black text-white text-xs font-black flex items-center justify-center mr-2 shadow">2</span>
            STEP 2. 나의 알레르기 선택
          </label>
          <button id="reset-allergy-btn" class="text-xs font-bold text-slate-500 hover:text-blue-600 flex items-center gap-1 transition">
            <i class="fa-solid fa-rotate-right"></i> 초기화
          </button>
        </div>

        <div id="allergy-tags-container" class="flex flex-wrap gap-2">
          <!-- JS에서 알레르기 버튼들이 생성됩니다 -->
        </div>
      </div>

      <!-- Submit / Check Button (PE Blue Accent Button) -->
      <button id="check-btn" class="w-full bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-black py-4 px-4 rounded-2xl shadow-lg hover:shadow-blue-600/30 transition transform active:scale-95 flex items-center justify-center gap-2 text-base">
        <i class="fa-solid fa-magnifying-glass text-lg"></i> 언주중학교 급식 분석하기
      </button>

    </div>

    <!-- Results Section (STEP 3, 4, 5) -->
    <div id="result-section" class="space-y-6">
      
      <!-- Summary Alert Box -->
      <div id="summary-card" class="bg-white rounded-3xl p-5 shadow-md border-2 border-black flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div id="status-icon" class="w-12 h-12 rounded-2xl bg-black text-white flex items-center justify-center text-2xl flex-shrink-0 shadow">
            <i class="fa-solid fa-utensils"></i>
          </div>
          <div>
            <h3 id="status-title" class="font-black text-black text-lg">STEP 5. 분석 결과</h3>
            <p id="status-desc" class="text-xs text-slate-600 font-bold mt-0.5">선택한 날짜 및 알레르기 분석 결과입니다.</p>
          </div>
        </div>
        <div id="status-badges" class="flex gap-2 w-full sm:w-auto justify-end">
          <!-- Status Badges inserted by JS -->
        </div>
      </div>

      <!-- Lunch Card (STEP 3 & 4) -->
      <div id="lunch-card-container">
        <!-- Lunch Card dynamically inserted by JS -->
      </div>

      <!-- Allergy Info Guide Footer -->
      <div class="bg-black border-2 border-black text-white rounded-2xl p-4 text-xs space-y-1.5 shadow">
        <p class="font-black text-blue-400 flex items-center gap-1.5">
          <i class="fa-solid fa-circle-info"></i> 교육부 지정 18가지 알레르기 유발물질 번호표
        </p>
        <p class="text-slate-300 font-medium">①난류 ②우유 ③메밀 ④땅콩 ⑤대두 ⑥밀 ⑦게 ⑧새우 ⑨돼지고기 ⑩복숭아 ⑪토마토 ⑫아황산류 ⑬호두 ⑭닭고기 ⑮쇠고기 ⑯오징어 ⑰조개류(굴,전복,홍합) ⑱잣</p>
      </div>

    </div>

  </main>

  <script>
    // 언주중학교 NEIS 교육청 코드 정보
    const NEIS_CONFIG = {
      ATPT_OFCDC_SC_CODE: 'B10', // 서울특별시교육청
      SD_SCHUL_CODE: '7091443'    // 언주중학교 학교코드
    };

    // 18가지 주요 알레르기 성분 목록
    const ALLERGY_LIST = [
      { id: 1, name: "난류(계란)" },
      { id: 2, name: "우유" },
      { id: 3, name: "메밀" },
      { id: 4, name: "땅콩" },
      { id: 5, name: "대두(콩)" },
      { id: 6, name: "밀" },
      { id: 7, name: "게" },
      { id: 8, name: "새우" },
      { id: 9, name: "돼지고기" },
      { id: 10, name: "복숭아" },
      { id: 11, name: "토마토" },
      { id: 12, name: "아황산류" },
      { id: 13, name: "호두" },
      { id: 14, name: "닭고기" },
      { id: 15, name: "쇠고기" },
      { id: 16, name: "오징어" },
      { id: 17, name: "조개류" },
      { id: 18, name: "잣" }
    ];

    // 현재 선택된 알레르기 ID 배열 (기본값: 계란, 우유)
    let selectedAllergies = [1, 2];

    // DOM Elements
    const dateInput = document.getElementById('meal-date');
    const allergyContainer = document.getElementById('allergy-tags-container');
    const checkBtn = document.getElementById('check-btn');
    const resetBtn = document.getElementById('reset-allergy-btn');
    const lunchCardContainer = document.getElementById('lunch-card-container');
    const statusIcon = document.getElementById('status-icon');
    const statusTitle = document.getElementById('status-title');
    const statusDesc = document.getElementById('status-desc');
    const statusBadges = document.getElementById('status-badges');

    // Initialize Application
    function init() {
      // Set today's date (YYYY-MM-DD)
      const today = new Date().toISOString().split('T')[0];
      dateInput.value = today;

      // Render Allergy Toggle Buttons
      renderAllergyButtons();

      // Initial Fetch & Analysis
      fetchAndAnalyze();

      // Event Listeners
      checkBtn.addEventListener('click', fetchAndAnalyze);
      resetBtn.addEventListener('click', () => {
        selectedAllergies = [];
        renderAllergyButtons();
        fetchAndAnalyze();
      });
    }

    // Render Allergy Select Buttons (Black & PE Blue Theme)
    function renderAllergyButtons() {
      allergyContainer.innerHTML = '';
      ALLERGY_LIST.forEach(item => {
        const isSelected = selectedAllergies.includes(item.id);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `px-3.5 py-2 rounded-xl text-xs font-bold border-2 transition duration-150 flex items-center gap-1.5 ${
          isSelected 
            ? 'bg-blue-600 border-blue-600 text-white shadow-md transform scale-105' 
            : 'bg-white border-slate-300 text-black hover:border-black'
        }`;
        
        btn.innerHTML = `
          <i class="fa-solid ${isSelected ? 'fa-check text-white' : 'fa-plus text-slate-400'}"></i>
          <span>${item.name}</span>
        `;

        btn.addEventListener('click', () => {
          if (selectedAllergies.includes(item.id)) {
            selectedAllergies = selectedAllergies.filter(id => id !== item.id);
          } else {
            selectedAllergies.push(item.id);
          }
          renderAllergyButtons();
        });

        allergyContainer.appendChild(btn);
      });
    }

    // Fetch NEIS Meal Data & Process
    async function fetchAndAnalyze() {
      const selectedDate = dateInput.value.replace(/-/g, ''); // YYYYMMDD 변환

      // Loading UI
      lunchCardContainer.innerHTML = `
        <div class="bg-white rounded-3xl p-12 text-center border-2 border-black shadow-md">
          <i class="fa-solid fa-spinner fa-spin text-4xl text-blue-600 mb-3"></i>
          <p class="text-black font-extrabold text-base">언주중학교 급식 데이터를 불러오는 중...</p>
        </div>
      `;

      try {
        // NEIS Open API Call (중식: MMEAL_SC_CODE=2)
        const url = `https://open.neis.go.kr/hub/mealServiceDietInfo?KEY=sample&Type=json&pIndex=1&pSize=100&ATPT_OFCDC_SC_CODE=${NEIS_CONFIG.ATPT_OFCDC_SC_CODE}&SD_SCHUL_CODE=${NEIS_CONFIG.SD_SCHUL_CODE}&MLSV_YMD=${selectedDate}`;
        const response = await fetch(url);
        const data = await response.json();

        if (data.mealServiceDietInfo && data.mealServiceDietInfo[1].row) {
          // 중식(MMEAL_SC_CODE === '2') 추출
          const lunchData = data.mealServiceDietInfo[1].row.find(row => row.MMEAL_SC_CODE === '2');

          if (lunchData) {
            const parsedMenuItems = parseDishString(lunchData.DDISH_NM);
            renderLunchCard(parsedMenuItems, lunchData.CAL_INFO);
          } else {
            renderNoMealCard("해당 날짜에 제공되는 점심 급식이 없습니다.");
          }
        } else {
          renderNoMealCard("해당 날짜의 언주중학교 급식 정보가 없습니다.");
        }
      } catch (error) {
        console.error("NEIS API Fetch Error:", error);
        renderNoMealCard("급식 데이터를 가져오는 중 오류가 발생했습니다.");
      }
    }

    // Parse NEIS dish string into dish names and allergy IDs
    function parseDishString(dishStr) {
      if (!dishStr) return [];
      
      const lines = dishStr.split('<br/>');
      return lines.map(line => {
        const cleanLine = line.replace(/<[^>]*>?/gm, '').trim();
        const allergyMatch = cleanLine.match(/\(([\d\.]+)\)/);
        let allergies = [];
        
        if (allergyMatch && allergyMatch[1]) {
          allergies = allergyMatch[1].split('.')
            .map(num => parseInt(num, 10))
            .filter(num => !isNaN(num));
        }

        const name = cleanLine.replace(/\([\d\.]+\)/g, '').trim();

        return { name, allergies };
      }).filter(item => item.name.length > 0);
    }

    // Render Lunch Results
    function renderLunchCard(menuItems, calInfo) {
      let totalDangerCount = 0;
      let menuListHTML = '';

      menuItems.forEach(item => {
        // STEP 4: 알레르기 분석
        const matched = item.allergies.filter(id => selectedAllergies.includes(id));
        const isDanger = matched.length > 0;

        if (isDanger) totalDangerCount++;

        const allergyNames = item.allergies.map(id => {
          const found = ALLERGY_LIST.find(a => a.id === id);
          return found ? found.name : id;
        }).join(', ');

        const dangerNames = matched.map(id => ALLERGY_LIST.find(a => a.id === id)?.name).join(', ');

        menuListHTML += `
          <li class="py-3.5 px-4 rounded-2xl border-2 transition ${isDanger ? 'bg-rose-50 border-rose-500' : 'bg-slate-50 border-transparent hover:border-slate-300'}">
            <div class="flex items-center justify-between">
              <span class="font-extrabold text-base ${isDanger ? 'text-rose-700' : 'text-black'}">
                ${item.name}
              </span>
              ${isDanger ? `
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-black bg-rose-600 text-white shadow-sm">
                  <i class="fa-solid fa-triangle-exclamation mr-1"></i> 위험/주의
                </span>
              ` : `
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                  <i class="fa-solid fa-check mr-1"></i> 안전
                </span>
              `}
            </div>
            
            <div class="mt-1 flex items-center justify-between text-xs">
              <span class="text-slate-500 font-medium">
                포함 성분: ${allergyNames || '없음'}
              </span>
              ${isDanger ? `
                <span class="font-black text-rose-600">
                  경고: ${dangerNames}
                </span>
              ` : ''}
            </div>
          </li>
        `;
      });

      // Lunch Card Insertion (Black & White & PE Blue Theme)
      lunchCardContainer.innerHTML = `
        <div class="bg-white rounded-3xl shadow-md border-2 border-black overflow-hidden">
          <div class="p-5 border-b-2 border-black flex items-center justify-between bg-black text-white">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-black">
                <i class="fa-solid fa-utensils"></i>
              </div>
              <div>
                <h3 class="font-black text-white text-base">STEP 3. 오늘의 점심 식단</h3>
                <p class="text-xs text-blue-400 font-bold">${calInfo || ''}</p>
              </div>
            </div>
            <span class="text-xs font-black px-3 py-1.5 rounded-full ${
              totalDangerCount > 0 
                ? 'bg-rose-600 text-white' 
                : 'bg-blue-600 text-white'
            }">
              ${totalDangerCount > 0 ? `주의 메뉴 ${totalDangerCount}개` : '모두 안전'}
            </span>
          </div>

          <ul class="p-5 space-y-2.5">
            ${menuListHTML}
          </ul>

          <div class="p-4 bg-slate-100 border-t-2 border-slate-200 text-center">
            <span class="text-xs font-bold text-slate-700">
              ${totalDangerCount > 0 ? '⚠️ 빨간색으로 표기된 메뉴에는 내 알레르기 성분이 포함되어 있습니다.' : '✅ 선택한 알레르기 유발 성분이 포함된 메뉴가 없습니다.'}
            </span>
          </div>
        </div>
      `;

      // Update Summary Header (STEP 5)
      if (selectedAllergies.length === 0) {
        statusIcon.className = 'w-12 h-12 rounded-2xl bg-black text-white flex items-center justify-center text-2xl flex-shrink-0';
        statusIcon.innerHTML = '<i class="fa-solid fa-info"></i>';
        statusTitle.textContent = '선택된 알레르기가 없습니다';
        statusDesc.textContent = '상단에서 내 알레르기를 지정해 주세요.';
        statusBadges.innerHTML = '';
      } else if (totalDangerCount > 0) {
        statusIcon.className = 'w-12 h-12 rounded-2xl bg-rose-600 text-white flex items-center justify-center text-2xl flex-shrink-0 shadow';
        statusIcon.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
        statusTitle.textContent = `오늘 주의할 메뉴가 ${totalDangerCount}개 있습니다!`;
        statusDesc.textContent = '붉은색 경고 박스가 뜬 식단은 피해주세요.';
        statusBadges.innerHTML = `
          <span class="px-3 py-1.5 bg-rose-600 text-white font-black text-xs rounded-xl flex items-center gap-1 shadow-sm">
            <i class="fa-solid fa-triangle-exclamation"></i> 위험 ${totalDangerCount}개
          </span>
        `;
      } else {
        statusIcon.className = 'w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center text-2xl flex-shrink-0 shadow';
        statusIcon.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
        statusTitle.textContent = '오늘 점심은 안심하고 드셔도 됩니다!';
        statusDesc.textContent = '선택하신 알레르기 유발 성분이 포함되어 있지 않습니다.';
        statusBadges.innerHTML = `
          <span class="px-3 py-1.5 bg-blue-600 text-white font-black text-xs rounded-xl flex items-center gap-1 shadow-sm">
            <i class="fa-solid fa-shield-halved"></i> 전체 안전
          </span>
        `;
      }
    }

    // Render Case when Meal Data is Missing
    function renderNoMealCard(message) {
      lunchCardContainer.innerHTML = `
        <div class="bg-white rounded-3xl p-10 text-center border-2 border-black shadow-md space-y-2">
          <div class="w-12 h-12 rounded-2xl bg-black text-white flex items-center justify-center mx-auto text-xl shadow">
            <i class="fa-solid fa-calendar-xmark"></i>
          </div>
          <p class="text-black font-extrabold text-base">${message}</p>
          <p class="text-xs text-slate-500 font-bold">주말/공휴일이거나 아직 급식표가 등록되지 않았습니다.</p>
        </div>
      `;

      statusIcon.className = 'w-12 h-12 rounded-2xl bg-black text-white flex items-center justify-center text-2xl flex-shrink-0';
      statusIcon.innerHTML = '<i class="fa-solid fa-slash"></i>';
      statusTitle.textContent = '급식 데이터 없음';
      statusDesc.textContent = message;
      statusBadges.innerHTML = '';
    }

    // Run App
    init();
  </script>
</body>
</html>
